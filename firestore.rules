rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Each user can only read/write their own profile document.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Cart items live under the owning user's doc.
      match /cart/{itemId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Orders are created by the owning user and never mutated afterwards.
      match /orders/{orderId} {
        allow read, create: if request.auth != null && request.auth.uid == userId;
        allow update, delete: if false;
      }
    }

    // Product catalog is public read, writable only from the Firebase
    // console / an admin script (no client writes).
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if false;
    }

    match /products/{productId} {
      allow read: if true;
      allow write: if false;
    }
  }
}
